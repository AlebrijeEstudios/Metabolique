@using AppVidaSana.Models.Dtos.Reset_Password_Dtos
@model ResetPasswordDto

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>

    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/css/headerStyle.css")" />
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/images/logoMetabolique.ico")">
</head>
<body>
    <nav class="custom-navbar">
        <div class="navbar-container">
            <a href="#" class="navbar-logo-link">
                <div class="navbar-logo-wrapper">
                    <img src="@Url.Content("~/images/logoMetabolique.png")" alt="Logo Metabolique" class="navbar-logo" />
                </div>
            </a>
        </div>
    </nav>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <h2 class="text-center mb-5">Restablecimiento de contraseña</h2>
                <form id="resetPasswordForm" class="form-signin">
                    <input type="hidden" name="token" value="@Model.token" />
                    <input type="hidden" name="email" value="@Model.email" />
                    <div class="form-group mb-4">
                        <label for="newpassword" class="form-label h6">Nueva Contraseña:</label>
                        <input type="password" id="newpassword" name="newpassword" class="form-control form-control-lg" placeholder="Ingresa tu nueva contraseña" required />
                    </div>
                    <div class="form-group mb-4">
                        <label for="confirmpassword" class="form-label h6">Confirmar Contraseña:</label>
                        <input type="password" id="confirmpassword" name="confirmpassword" class="form-control form-control-lg" placeholder="Confirma tu nueva contraseña" required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg btn-block">
                        <output id="resetSpinner" class="spinner-border spinner-border-sm me-2" aria-hidden="true" style="display: none;"></output>
                        <span id="resetText">Restablecer contraseña</span>
                    </button>
                </form>

                <div id="message" class="alert mt-3" role="alert" style="display: none;"></div>

                <div id="successMessage" class="text-center mt-4" style="display: none;">
                    <div class="alert alert-success alert-lg">
                        <h4 class="mb-3"><i class="fa fa-check-circle"></i> ¡Contraseña actualizada exitosamente!</h4>
                        <p class="mb-0">Puedes regresar a la app para iniciar sesión.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.addEventListener("keydown", function (e) {
            if (e.key === "Backspace" && !["INPUT", "TEXTAREA"].includes(e.target.tagName)) {
                e.preventDefault();
            }

            if ((e.altKey && (e.key === "ArrowLeft" || e.key === "ArrowRight"))) {
                e.preventDefault();
            }
        });

        function showLoadingState() {
            const resetSpinner = document.getElementById('resetSpinner');
            const resetText = document.getElementById('resetText');
            const submitButton = document.querySelector('button[type="submit"]');

            resetSpinner.style.display = 'inline-block';
            resetText.textContent = 'Procesando...';
            submitButton.disabled = true;
        }

        function hideLoadingState() {
            const resetSpinner = document.getElementById('resetSpinner');
            const resetText = document.getElementById('resetText');
            const submitButton = document.querySelector('button[type="submit"]');

            resetSpinner.style.display = 'none';
            resetText.textContent = 'Restablecer contraseña';
            submitButton.disabled = false;
        }

        document.getElementById('resetPasswordForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const formData = {
                token: document.querySelector('input[name="token"]').value,
                email: document.querySelector('input[name="email"]').value,
                password: document.getElementById('newpassword').value,
                confirmpassword: document.getElementById('confirmpassword').value
            };

            const messageDiv = document.getElementById('message');
            const successMessage = document.getElementById("successMessage");
            const form = document.getElementById("resetPasswordForm");

            messageDiv.style.display = "none";
            messageDiv.textContent = "";
            successMessage.style.display = "none";

            showLoadingState();

            try {
                const response = await fetch('/api/forgot-password/reset-password', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Metabolique_API_KEY': '@Environment.GetEnvironmentVariable("API_KEY")',
                        'Authorization': `Bearer ${formData.token}`
                    },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (response.ok) {
                    form.style.display = "none";
                    messageDiv.style.display = "none";

                    const serverMessage = data.status;
                    const successTitle = document.querySelector('#successMessage h4');
                    successTitle.textContent = serverMessage;
                    successMessage.style.display = "block";
                } else {
                    messageDiv.style.display = "block";
                    messageDiv.className = "alert alert-danger mt-3";

                    switch (response.status) {
                        case 400:
                            messageDiv.innerHTML = data.status;
                            break;
                        case 401:
                            messageDiv.innerHTML = data.message;
                            break;
                        case 409:
                            messageDiv.innerHTML = data.status;
                            break;
                        case 429:
                            messageDiv.innerHTML = data.message;
                            break;
                        case 500:
                            messageDiv.innerHTML = data.status;
                            break;
                        case 503:
                            messageDiv.innerHTML = data.message;
                            break;
                        default:
                            messageDiv.textContent = "Ha ocurrido un error inesperado.";
                            break;
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                messageDiv.style.display = "block";
                messageDiv.textContent = 'Error de red. Intenta nuevamente.';
                messageDiv.className = "alert alert-danger mt-3";
            }
            finally {
                if (successMessage.style.display === "none") {
                    hideLoadingState();
                }
            }
        });
    </script>
    <script>
        if (window.history.replaceState) {
            const url = new URL(window.location);
            url.searchParams.delete('token');
            url.searchParams.delete('email');
            window.history.replaceState({}, document.title, url.pathname);
        }
    </script>
</body>
</html>